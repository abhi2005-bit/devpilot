# Copy this file to .env for local development.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/devpilot
GROQ_API_KEY=replace-with-your-groq-api-key
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Optional settings; these values match the application defaults.
GROQ_MODEL=openai/gpt-oss-20b
DEV_USER_EMAIL=devpilot@example.com
DEV_USER_NAME=DevPilot User
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
